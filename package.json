{
  "name": "labelixa-mcp",
  "version": "0.4.1",
  "mcpName": "com.labelixa/zpl",
  "description": "Thermal label MCP server (local stdio): render, validate, debug and convert ZPL, EPL, TSPL and CPCL labels via the Labelixa API. Full tool set on the hosted server https://api.labelixa.com/mcp.",
  "type": "module",
  "bin": {
    "labelixa-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "tools.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/tools.test.mjs test/contract.test.mjs",
    "check-publish": "node scripts/check-publish.mjs",
    "prepublishOnly": "node scripts/check-publish.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "keywords": [
    "zpl",
    "epl",
    "tspl",
    "cpcl",
    "zebra",
    "label",
    "barcode",
    "printing",
    "label-printing",
    "thermal-printer",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai"
  ],
  "license": "MIT",
  "homepage": "https://labelixa.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Labelixa/labelixa-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Labelixa/labelixa-mcp/issues",
    "email": "support@labelixa.com"
  }
}
